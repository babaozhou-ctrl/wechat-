<scroll-view class="page" scroll-y enhanced shows-scrollbar="{{false}}">
<view class="page-content">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack">
      <text class="nav-back">‹</text>
    </view>
    <text class="nav-title">体重记录</text>
    <view class="nav-right" bindtap="onAdd">
      <text class="add-btn">+ 记录</text>
    </view>
  </view>

  <!-- 当前体重卡片 -->
  <view class="current-card">
    <view class="current-weight">
      <text class="weight-value">{{currentWeight}}</text>
      <text class="weight-unit">kg</text>
    </view>
    <view class="weight-change" wx:if="{{weightChange !== 0}}">
      <text class="change-value {{weightChange < 0 ? 'down' : 'up'}}">
        {{weightChange < 0 ? '↓' : '↑'}} {{weightChangeAbs}} kg
      </text>
      <text class="change-period">较上周</text>
    </view>
    <view class="target-info">
      <view class="target-item">
        <text class="target-label">目标</text>
        <text class="target-value">{{targetWeight}} kg</text>
      </view>
      <view class="target-item">
        <text class="target-label">BMI</text>
        <text class="target-value">{{bmi}}</text>
      </view>
      <view class="target-item">
        <text class="target-label">距离目标</text>
        <text class="target-value {{distanceToTarget < 0 ? 'over' : ''}}">{{distanceToTargetAbs}} kg</text>
      </view>
    </view>
  </view>

  <!-- 体重趋势图 -->
  <view class="chart-section">
    <text class="section-title">体重趋势</text>
    <view class="chart-placeholder">
      <view class="chart-line">
        <view 
          wx:for="{{chartPoints}}" 
          wx:key="index"
          class="chart-point"
          style="left: {{item.x}}%; bottom: {{item.y}}%"
        >
          <view class="point-dot"></view>
          <text class="point-label">{{item.weight}}kg</text>
        </view>
      </view>
      <view class="chart-grid">
        <text class="grid-line" wx:for="{{[100,80,60,40,20]}}" wx:key="index">{{item}}</text>
      </view>
    </view>
    <view class="chart-legend">
      <text class="legend-item">近7天</text>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="history-section">
    <text class="section-title">历史记录</text>
    <view class="history-list">
      <view wx:for="{{records}}" wx:key="id" class="history-item">
        <view class="item-date">
          <text class="date-day">{{item.day}}</text>
          <text class="date-month">{{item.month}}月</text>
        </view>
        <view class="item-content">
          <text class="item-weight">{{item.weight}} kg</text>
          <text class="item-bmi">BMI {{item.bmi}}</text>
        </view>
        <view class="item-change">
          <text class="change {{item.change < 0 ? 'down' : item.change > 0 ? 'up' : ''}}">
            {{item.change > 0 ? '+' : ''}}{{item.change}} kg
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 身高记录入口 -->
  <view class="height-section" bindtap="onRecordHeight">
    <view class="height-info">
      <text class="height-icon">📏</text>
      <view class="height-text">
        <text class="height-title">身高记录</text>
        <text class="height-value">当前: {{height}} cm</text>
      </view>
    </view>
    <text class="height-arrow">›</text>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-bottom"></view>
</view>
</scroll-view>
