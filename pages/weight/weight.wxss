/* pages/weight/weight.wxss */

.page {
  height: 100vh;
  background: #f5f6f8;
}

.page-content {
  padding-bottom: 40rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 20rpx;
  background: #fff;
}

.nav-left, .nav-right {
  width: 140rpx;
}

.nav-back {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.add-btn {
  font-size: 28rpx;
  color: #5B8DEF;
  font-weight: 500;
}

/* 当前体重卡片 */
.current-card {
  background: linear-gradient(135deg, #FFB3B3 0%, #FF8585 100%);
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  text-align: center;
}

.current-weight {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.weight-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #fff;
}

.weight-unit {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 8rpx;
}

.weight-change {
  margin-top: 12rpx;
}

.change-value {
  font-size: 28rpx;
  color: #fff;
}

.change-value.down {
  color: #51CF66;
}

.change-value.up {
  color: #FFD93D;
}

.change-period {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 8rpx;
}

.target-info {
  display: flex;
  justify-content: space-around;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.target-item {
  display: flex;
  flex-direction: column;
}

.target-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.target-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-top: 4rpx;
}

.target-value.over {
  color: #FFD93D;
}

/* 趋势图 */
.chart-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  display: block;
}

.chart-placeholder {
  height: 200rpx;
  position: relative;
  background: linear-gradient(to top, #f5f6f8, transparent);
  border-radius: 12rpx;
}

.chart-line {
  position: absolute;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
  height: 120rpx;
}

.chart-point {
  position: absolute;
  transform: translateX(-50%);
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  background: #FF8585;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(255, 133, 133, 0.5);
}

.point-label {
  position: absolute;
  top: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #666;
  white-space: nowrap;
}

.chart-grid {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column-reverse;
}

.grid-line {
  font-size: 18rpx;
  color: #ccc;
  height: 40rpx;
  line-height: 40rpx;
}

.chart-legend {
  text-align: center;
  margin-top: 20rpx;
}

.legend-item {
  font-size: 22rpx;
  color: #999;
  padding: 8rpx 24rpx;
  background: #f5f6f8;
  border-radius: 20rpx;
}

/* 历史记录 */
.history-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
}

.history-list {
  margin-top: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.item-date {
  width: 80rpx;
  text-align: center;
}

.date-day {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.date-month {
  font-size: 20rpx;
  color: #999;
}

.item-content {
  flex: 1;
  margin-left: 20rpx;
}

.item-weight {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.item-bmi {
  font-size: 22rpx;
  color: #999;
}

.item-change {
  text-align: right;
}

.change {
  font-size: 26rpx;
  color: #999;
}

.change.down {
  color: #51CF66;
}

.change.up {
  color: #FF6B6B;
}

/* 身高记录 */
.height-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
}

.height-info {
  display: flex;
  align-items: center;
}

.height-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.height-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.height-value {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.height-arrow {
  font-size: 32rpx;
  color: #ccc;
}
