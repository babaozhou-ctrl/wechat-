<scroll-view class="page" scroll-y enhanced shows-scrollbar="{{false}}">
<view class="page-content">
  <view class="nav-bar">
    <view class="nav-left" bindtap="onBack"><text class="nav-back">‹</text></view>
    <text class="nav-title">个人中心</text>
    <view class="nav-right"></view>
  </view>
  
  <!-- 头像昵称卡片 -->
  <view class="profile-card">
    <view class="avatar-wrapper" bindtap="onEditAvatar">
      <view class="avatar">{{userInfo.avatar}}</view>
      <view class="edit-avatar-tip">点击修改</view>
    </view>
    <view class="nickname-wrapper" bindtap="onEditNickname">
      <text class="nickname">{{userInfo.nickname}}</text>
      <text class="edit-icon">✏️</text>
    </view>
  </view>
  
  <view class="settings-section">
    <view class="section-title">健康目标</view>
    <view class="setting-item" bindtap="onEditTarget" data-type="calories">
      <text class="setting-icon">🔥</text>
      <text class="setting-label">每日热量目标</text>
      <text class="setting-value">{{targets.calories}} 千卡</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onEditTarget" data-type="weight">
      <text class="setting-icon">⚖️</text>
      <text class="setting-label">目标体重</text>
      <text class="setting-value">{{targets.weight}} kg</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onEditTarget" data-type="water">
      <text class="setting-icon">💧</text>
      <text class="setting-label">每日饮水目标</text>
      <text class="setting-value">{{targets.water}} ml</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onEditTarget" data-type="sleep">
      <text class="setting-icon">😴</text>
      <text class="setting-label">每日睡眠目标</text>
      <text class="setting-value">{{targets.sleep}} 小时</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>
  
  <view class="settings-section">
    <view class="section-title">身体数据</view>
    <view class="setting-item" bindtap="onEditBody" data-type="height">
      <text class="setting-icon">📏</text>
      <text class="setting-label">身高</text>
      <text class="setting-value">{{body.height}} cm</text>
      <text class="setting-arrow">›</text>
    </view>
    <view class="setting-item" bindtap="onEditBody" data-type="age">
      <text class="setting-icon">🎂</text>
      <text class="setting-label">年龄</text>
      <text class="setting-value">{{body.age}} 岁</text>
      <text class="setting-arrow">›</text>
    </view>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-bottom"></view>
</view>
</scroll-view>
