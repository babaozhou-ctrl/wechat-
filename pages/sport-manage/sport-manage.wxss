/* pages/sport-manage/sport-manage.wxss */

.page {
  height: 100vh;
  background: #f5f5f5;
}

.page-content {
  padding-bottom: 40rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left {
  display: flex;
  align-items: center;
  width: 120rpx;
}

.back-icon {
  font-size: 48rpx;
  color: #07c160;
  margin-right: 4rpx;
}

.back-text {
  font-size: 28rpx;
  color: #07c160;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.nav-right {
  width: 120rpx;
}

.section {
  margin: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sport-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sport-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.sport-left {
  display: flex;
  align-items: center;
}

.sport-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.sport-info {
  display: flex;
  flex-direction: column;
}

.sport-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.sport-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.sport-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.action-btn.edit {
  color: #07c160;
  background: #e8f5e9;
}

.action-btn.delete {
  color: #ff4d4f;
  background: #fff1f0;
}

/* 添加表单 */
.add-form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-item {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
}

.icon-item.selected {
  border-color: #07c160;
  background: #e8f5e9;
}

.icon-emoji {
  font-size: 40rpx;
}

.add-btn {
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #07c160, #05a554);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.add-btn::after {
  border: none;
}
