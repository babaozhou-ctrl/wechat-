/* pages/sport-target/sport-target.wxss */

.page {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
}

.page-content {
  padding-bottom: 40rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  padding-top: env(safe-area-inset-top);
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left, .nav-right {
  width: 120rpx;
}

.nav-btn {
  font-size: 28rpx;
  color: #666;
}

.nav-btn.confirm {
  color: #07c160;
  font-weight: 600;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 运动类型显示 */
.sport-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #07c160, #05a554);
}

.sport-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.sport-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 标签切换 */
.tab-container {
  background: #fff;
  padding: 20rpx 30rpx;
}

.tab-list {
  display: flex;
  background: #f5f5f5;
  border-radius: 16rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: #07c160;
  color: #fff;
  font-weight: 600;
}

/* 主显示区域 */
.main-display {
  margin: 30rpx 30rpx 20rpx;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.value-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.value-number {
  font-size: 96rpx;
  font-weight: 700;
  color: #07c160;
  line-height: 1;
}

.value-unit {
  font-size: 32rpx;
  color: #999;
  margin-left: 12rpx;
}

.value-label {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
}

/* 历史记录提示 */
.history-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx;
  margin: 0 30rpx 20rpx;
  background: linear-gradient(90deg, #fff7e6, #fff3d6);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #b38600;
}

.history-icon {
  margin-right: 8rpx;
}

/* 快捷选项 */
.quick-options {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.options-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  text-align: center;
}

.options-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.option-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 90rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
}

.option-item.selected {
  background: #e8f5e9;
  border-color: #07c160;
}

.option-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.option-item.selected .option-value {
  color: #07c160;
}

.option-unit {
  font-size: 18rpx;
  color: #999;
  margin-top: 2rpx;
}

/* 滑动选择器 */
.slider-section {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.value-slider {
  margin: 16rpx 0;
}

.slider-range {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

/* 数据项选择 */
.display-config {
  margin: 0 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.config-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.config-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.config-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
}

.config-item.active {
  background: #e8f5e9;
  border-color: #07c160;
}

.config-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.config-label {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.config-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.config-item.active .config-check {
  background: #07c160;
}

.config-check text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
}

/* 开始按钮 */
.action-section {
  padding: 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.start-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #07c160, #05a554);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}