/* pages/diet-add/diet-add.wxss - 简洁风格 */

.page {
  height: 100vh;
  background: #f5f5f5;
}

.page-content {
  padding-bottom: 40rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 50rpx 30rpx 20rpx;
  background: #fff;
}

.nav-left, .nav-right {
  width: 120rpx;
}

.nav-back {
  font-size: 44rpx;
  color: #333;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx 30rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

/* 快速添加 */
.quick-add {
  padding: 0 30rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.food-item {
  width: calc(33.33% - 11rpx);
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  position: relative;
}

.food-item.custom-food {
  background: #FFF9F0;
  border: 1rpx solid #FFE4C4;
}

.food-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.food-icon {
  font-size: 44rpx;
  display: block;
}

.food-icon-img {
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
}

.food-name {
  font-size: 22rpx;
  color: #333;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.food-cal {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: #FF6B35;
  border-radius: 50%;
  font-weight: bold;
  z-index: 10;
}

/* 自定义标签 */
.custom-tag {
  display: inline-block;
  font-size: 16rpx;
  color: #FF9A56;
  background: rgba(255, 154, 86, 0.15);
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
  margin-top: 4rpx;
}

/* 自定义提示 */
.custom-hint {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: rgba(91, 141, 239, 0.08);
  border-radius: 10rpx;
}

.hint-text {
  font-size: 20rpx;
  color: #5B8DEF;
}

/* 搜索结果 */
.search-results {
  padding: 0 30rpx;
  background: #fff;
  margin: 16rpx 30rpx;
  border-radius: 12rpx;
}

.result-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-left {
  display: flex;
  align-items: center;
}

.result-icon {
  font-size: 36rpx;
  margin-right: 14rpx;
}

.result-info {
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.result-desc {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.result-add {
  width: 50rpx;
  height: 50rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 32rpx;
  color: #5B8DEF;
  border: 2rpx solid #5B8DEF;
  border-radius: 50%;
}

/* 无搜索结果 */
.no-result {
  text-align: center;
  padding: 50rpx 30rpx;
  background: #fff;
  margin: 16rpx 30rpx;
  border-radius: 12rpx;
}

.no-result-text {
  font-size: 26rpx;
  color: #666;
  display: block;
}

.no-result-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 自定义添加 */
.custom-add {
  padding: 30rpx 30rpx 0;
}

.custom-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item.half {
  width: calc(50% - 10rpx);
}

.form-row {
  display: flex;
  justify-content: space-between;
}

.form-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 18rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.icon-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.icon-option {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 36rpx;
  background: #f5f5f5;
  border-radius: 14rpx;
  border: 4rpx solid transparent;
}

.icon-option.selected {
  border-color: #5B8DEF;
  background: #E5F4FF;
}

/* 自定义图片上传 */
.custom-image-picker {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.custom-image-btn {
  background: #f0f0f0;
  border: 2rpx dashed #ccc;
  color: #999;
  font-size: 44rpx;
}

.custom-image-btn.selected {
  border-style: solid;
  border-color: #5B8DEF;
  background: #E5F4FF;
  color: transparent;
}

.custom-image-preview {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
}

.custom-image-hint {
  font-size: 20rpx;
  color: #999;
  margin-left: 14rpx;
}

/* 底部保存按钮 */
.bottom-action {
  padding: 30rpx;
  margin-top: 16rpx;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #5B8DEF;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-icon {
  font-size: 28rpx;
  color: #fff;
  margin-right: 10rpx;
}

.save-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

/* 安全底部 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  height: constant(safe-area-inset-bottom);
}
