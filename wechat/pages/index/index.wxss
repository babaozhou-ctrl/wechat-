/* pages/index/index.wxss - 简洁风格健康追踪UI */

.page {
  height: 100vh;
  background: #f5f5f5;
}

.page-content {
  padding-bottom: 40rpx;
}

/* 顶部欢迎区域 */
.header {
  padding: 50rpx 30rpx 30rpx;
  background: #fff;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.user-name {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 健康数据卡片 */
.health-cards {
  display: flex;
  padding: 20rpx 30rpx 0;
  gap: 20rpx;
}

.health-cards.second-row {
  padding-top: 20rpx;
}

.health-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.calories-card {
  flex: 1;
  background: #FF6B35;
}

.steps-card {
  flex: 1;
  background: #5B8DEF;
}

.mini-card {
  flex: 1;
  padding: 18rpx 14rpx;
}

.weight-card {
  background: #FF8585;
}

.water-card {
  background: #5BA8D8;
}

.sleep-card {
  background: #9090FF;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.card-title {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card-value {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.mini-value {
  margin-bottom: 6rpx;
}

.value-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}

.mini-card .value-number {
  font-size: 32rpx;
}

.value-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 6rpx;
}

.card-progress {
  display: flex;
  flex-direction: column;
}

.progress-bar {
  height: 6rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 3rpx;
  overflow: hidden;
  margin-bottom: 6rpx;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 3rpx;
}

.progress-text {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-change {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card-change.up {
  color: #FF6B6B;
}

.card-change.down {
  color: #51CF66;
}

/* 快速记录区域 */
.quick-actions {
  padding: 30rpx 30rpx 0;
}

.quick-actions .section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.action-grid {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.action-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.action-icon text {
  font-size: 44rpx;
}

.diet-icon {
  background: #FFE5E5;
}

.water-icon {
  background: #E5F4FF;
}

.weight-icon {
  background: #FFF0E5;
}

.sport-icon {
  background: #E5FFE5;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

/* 饮食记录区域 */
.meal-section {
  padding: 30rpx 30rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-header .section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 22rpx;
  color: #5B8DEF;
}

.meal-tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
}

.meal-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 6rpx;
  border-radius: 12rpx;
}

.meal-tab.active {
  background: #5B8DEF;
}

.meal-icon {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.meal-name {
  font-size: 20rpx;
  color: #666;
  font-weight: 500;
}

.meal-tab.active .meal-name {
  color: #fff;
}

.meal-cal {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

.meal-tab.active .meal-cal {
  color: rgba(255, 255, 255, 0.8);
}

.meal-items {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
}

.meal-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meal-item:last-of-type {
  border-bottom: none;
}

.meal-item-left {
  display: flex;
  align-items: center;
}

.meal-item-icon {
  font-size: 36rpx;
  margin-right: 14rpx;
}

.meal-item-info {
  display: flex;
  flex-direction: column;
}

.meal-item-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.meal-item-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.meal-item-cal {
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
}

.meal-add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.add-icon {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5B8DEF;
  border: 2rpx solid #5B8DEF;
  border-radius: 50%;
  margin-right: 10rpx;
}

.add-text {
  font-size: 24rpx;
  color: #5B8DEF;
  font-weight: 500;
}

/* 运动记录区域 */
.sport-section {
  padding: 30rpx 30rpx 0;
}

.sport-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.sport-item {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sport-item:last-child {
  border-bottom: none;
}

.sport-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.sport-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.sport-arrow {
  font-size: 28rpx;
  color: #ccc;
}

.start-sport-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #5B8DEF;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  border: none;
  margin-top: 20rpx;
}

.start-sport-btn[disabled] {
  background: #ccc;
}

/* 右下角用户悬浮按钮 */
.float-profile-btn {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
}

.float-profile-icon {
  font-size: 52rpx;
}
