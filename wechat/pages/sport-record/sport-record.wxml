<view class="page">
  <!-- 语音提示覆盖层 -->
  <view class="voice-tip-overlay" wx:if="{{showVoiceTip}}">
    <view class="voice-tip-content">
      <text class="voice-tip-text">{{voiceTip}}</text>
    </view>
  </view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-left">
      <view class="sport-type">
        <text class="sport-icon">{{sportIcon}}</text>
        <text class="sport-name">{{sportName}}</text>
      </view>
    </view>
    <view class="nav-right">
      <view class="nav-actions">
        <!-- 语音开关 -->
        <view class="voice-btn {{voiceEnabled ? 'active' : ''}}" bindtap="onToggleVoice">
          <text class="voice-icon">{{voiceEnabled ? '🔊' : '🔇'}}</text>
        </view>
        <!-- GPS状态 -->
        <view class="gps-status {{gpsStatus === 'connected' ? 'active' : ''}}">
          <text class="gps-dot"></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 迷你地图区域 - 可调节大小 -->
  <view class="map-container" style="height: {{mapHeight}}px;">
    <map 
      id="miniMap"
      class="mini-map"
      latitude="{{location.latitude}}"
      longitude="{{location.longitude}}"
      scale="16"
      show-location="{{true}}"
      enable-overlooking="{{true}}"
      enable-3D="{{true}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
    ></map>
    <view class="map-overlay" wx:if="{{!isRecording}}">
      <text class="map-hint">📍 GPS定位中...</text>
    </view>
    
    <!-- 地图大小调节器 -->
    <view class="map-resizer" bindtap="onResizeMap">
      <text class="resize-icon">{{mapSize === 'fullscreen' ? '⬇️' : '⬆️'}}</text>
      <text class="resize-text">{{mapSize === 'small' ? '小' : mapSize === 'medium' ? '中' : mapSize === 'large' ? '大' : '全屏'}}</text>
    </view>
  </view>

  <!-- 核心数据显示区域 -->
  <view class="data-display">
    <!-- 总距离 -->
    <view class="data-card primary" wx:if="{{displayConfig.showDistance}}">
      <text class="data-value">{{totalDistance}}</text>
      <text class="data-unit">公里</text>
      <text class="data-label">总距离</text>
    </view>

    <!-- 第二行数据 -->
    <view class="data-row">
      <view class="data-card" wx:if="{{displayConfig.showDuration}}">
        <text class="data-value">{{totalDuration}}</text>
        <text class="data-unit"></text>
        <text class="data-label">训练时长</text>
      </view>
      
      <view class="data-card" wx:if="{{displayConfig.showSpeed}}">
        <text class="data-value">{{currentSpeed}}</text>
        <text class="data-unit">km/h</text>
        <text class="data-label">均速</text>
      </view>
      
      <view class="data-card" wx:if="{{displayConfig.showCalories}}">
        <text class="data-value">{{totalCalories}}</text>
        <text class="data-unit">kcal</text>
        <text class="data-label">消耗</text>
      </view>
    </view>
  </view>

  <!-- 底部控制按钮 -->
  <view class="bottom-controls">
    <view class="control-btn lock" bindtap="onLock">
      <text class="btn-icon">{{isLocked ? '🔓' : '🔒'}}</text>
      <text class="btn-text">{{isLocked ? '解锁' : '锁屏'}}</text>
    </view>
    
    <view class="control-btn main-btn {{isRunning ? 'pause' : 'start'}}" bindtap="onToggleRecord">
      <text class="btn-icon-large">{{isRunning ? '⏸' : '▶'}}</text>
      <text class="btn-text">{{isRunning ? '暂停' : '开始'}}</text>
    </view>
    
    <view class="control-btn settings" bindtap="onSettings">
      <text class="btn-icon">⚙️</text>
      <text class="btn-text">设置</text>
    </view>
  </view>

  <!-- 锁屏覆盖层 -->
  <view class="lock-overlay" wx:if="{{isLocked}}" bindtap="onUnlock">
    <view class="lock-content">
      <text class="lock-icon">🔒</text>
      <text class="lock-hint">点击屏幕任意位置解锁</text>
    </view>
  </view>
</view>
