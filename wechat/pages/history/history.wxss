/* pages/history/history.wxss */

/* 页面基础样式 */
.page {
  height: 100vh;
  background: #f5f5f5;
}

.page-content {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部导航 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.nav-left, .nav-right {
  width: 80rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-back {
  font-size: 44rpx;
  color: #333;
}

.today-btn {
  font-size: 26rpx;
  color: #5B8DEF;
  padding: 8rpx 16rpx;
  border: 1rpx solid #5B8DEF;
  border-radius: 20rpx;
}

/* 时间维度选择 */
.view-mode-bar {
  background: #fff;
  padding: 20rpx 30rpx;
}

.view-mode-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 24rpx;
  padding: 4rpx;
}

.view-mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.view-mode-tab.active {
  background: #5B8DEF;
  color: #fff;
  font-weight: 500;
}

/* 日期导航 */
.date-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.date-nav-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.nav-arrow {
  font-size: 36rpx;
  color: #666;
}

.date-display {
  flex: 1;
  text-align: center;
}

.date-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tab-item {
  flex: 1;
  min-width: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  opacity: 0.6;
  transition: all 0.3s;
}

.tab-item.active {
  opacity: 1;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 22rpx;
  color: #666;
}

.tab-item.active .tab-name {
  color: #5B8DEF;
  font-weight: 500;
}

/* 加载状态 */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* 数据内容区 */
.data-content {
  padding: 0 30rpx;
}

/* 概览卡片 */
.overview-card {
  background: linear-gradient(135deg, #5B8DEF 0%, #6BA3FF 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.overview-main {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 16rpx;
}

.overview-value {
  font-size: 72rpx;
  font-weight: 700;
}

.overview-unit {
  font-size: 28rpx;
  margin-left: 12rpx;
  opacity: 0.9;
}

.overview-trend {
  text-align: center;
  font-size: 26rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.overview-trend.up {
  color: #FF6B6B;
}

.overview-trend.down {
  color: #51CF66;
}

.overview-sub {
  text-align: center;
  font-size: 26rpx;
  opacity: 0.9;
}

.overview-target {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.target-label {
  margin-right: 8rpx;
}

.target-value {
  font-weight: 500;
}

.overview-row {
  display: flex;
  align-items: center;
  justify-content: center;
}

.overview-item {
  flex: 1;
  text-align: center;
}

.overview-label {
  display: block;
  font-size: 24rpx;
  margin-top: 8rpx;
  opacity: 0.9;
}

.overview-divider {
  width: 1rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 饮水进度 */
.water-progress {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  margin-left: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 步数进度环 */
.steps-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}

.progress-ring {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.ring-bg, .ring-fill {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ring-bg {
  background: rgba(255, 255, 255, 0.2);
}

.ring-fill {
  background: conic-gradient(#fff 0deg, #fff var(--deg, 0deg), transparent var(--deg, 0deg));
}

.progress-goal {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 图表卡片 */
.chart-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.chart-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}

.chart-bars {
  display: flex;
  overflow-x: auto;
  padding-bottom: 20rpx;
}

.chart-bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  min-width: 80rpx;
}

.bar-container {
  width: 40rpx;
  height: 150rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  border-radius: 8rpx;
  transition: height 0.3s;
}

.bar-fill.weight {
  background: linear-gradient(180deg, #5B8DEF 0%, #8BB5FF 100%);
}

.bar-label {
  font-size: 20rpx;
  color: #333;
  margin-top: 8rpx;
}

.bar-date {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 睡眠质量显示 */
.sleep-quality-display {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.quality-star {
  font-size: 48rpx;
  margin: 0 8rpx;
  opacity: 0.3;
}

.quality-star.active {
  opacity: 1;
}

/* 记录卡片 */
.records-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.records-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 记录列表 */
.record-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.record-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.record-image {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.record-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999;
}

.record-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.record-cal {
  font-size: 28rpx;
  color: #FF9A56;
  font-weight: 500;
}

.record-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 饮食列表特殊样式 */
.diet-item .record-left {
  max-width: 70%;
}

.diet-item .record-right {
  flex: none;
}

/* 底部安全区域 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
}
