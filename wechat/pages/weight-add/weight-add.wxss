/* pages/weight-add/weight-add.wxss */

.page {
  height: 100vh;
  background: #f5f6f8;
}

.page-content {
  padding-bottom: 40rpx;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 20rpx;
  background: #fff;
}

.nav-left {
  width: 80rpx;
}

.nav-back {
  font-size: 48rpx;
  color: #333;
  font-weight: 300;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 体重输入 */
.weight-input-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  text-align: center;
}

.weight-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 40rpx;
}

.weight-value {
  font-size: 120rpx;
  font-weight: 700;
  color: #FF8585;
}

.weight-unit {
  font-size: 36rpx;
  color: #999;
  margin-left: 12rpx;
}

.weight-slider {
  margin: 0 20rpx;
}

.weight-range {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #ccc;
}

/* 时间选择 */
.time-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.time-options {
  display: flex;
  gap: 20rpx;
}

.time-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
}

.time-option.active {
  background: #FFF0F0;
  border-color: #FF8585;
}

.time-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.time-text {
  font-size: 24rpx;
  color: #666;
}

.time-option.active .time-text {
  color: #FF8585;
  font-weight: 500;
}

/* 备注 */
.note-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
}

.note-input {
  width: 100%;
  height: 120rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 历史对比 */
.compare-section {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
}

.compare-card {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f5f6f8;
  border-radius: 16rpx;
}

.compare-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.compare-info {
  display: flex;
  flex-direction: column;
}

.compare-last {
  font-size: 24rpx;
  color: #999;
}

.compare-change {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.compare-change.down {
  color: #51CF66;
}

.compare-change.up {
  color: #FF6B6B;
}

/* 底部保存按钮 */
.bottom-action {
  padding: 30rpx;
  margin-top: 20rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FFB3B3 0%, #FF8585 100%);
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 133, 133, 0.3);
}

.save-icon {
  font-size: 32rpx;
  color: #fff;
  margin-right: 12rpx;
}

.save-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

/* 安全底部 */
.safe-bottom {
  height: env(safe-area-inset-bottom);
  height: constant(safe-area-inset-bottom);
}
